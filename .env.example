# --- API-Football (api-sports.io) ---
# Your only required key for soccer. Paid plan recommended for full coverage.
# Direct (default): get the key from https://dashboard.api-football.com/
# RapidAPI users: change API_FOOTBALL_HOST below to the RapidAPI host.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
# For RapidAPI, set the host to: api-football-v1.p.rapidapi.com

# --- API-Baseball (api-sports.io) ---
# Used ONLY for MLB odds (MLB Stats API doesn't carry odds). Subscription is
# sold separately by API-Sports; if you bundle, the same key as API-Football
# may work — the client falls back to API_FOOTBALL_KEY if this is blank.
# https://dashboard.api-football.com/  (manage subscriptions)
API_BASEBALL_KEY=

# --- API-American-Football (api-sports.io) ---
# NFL + NCAA football: games, odds, injuries. Falls back to API_FOOTBALL_KEY
# if blank.
API_AMERICAN_FOOTBALL_KEY=

# --- API-Hockey (api-sports.io) ---
# NHL games/odds. Falls back to API_FOOTBALL_KEY if blank.
API_HOCKEY_KEY=

# --- CollegeFootballData (CFBD) ---
# NCAA label source of record (ARCHITECT 2026-10-07): `ncaa-cfbd-labels`
# reads it from here. Free Bearer key from collegefootballdata.com. Never
# printed; payloads stay under exports/ (their terms forbid republishing).
CFBD_API_KEY=

# --- The Odds API (legacy/unused — kept for future use) ---
# https://the-odds-api.com/  (free tier 500/month)
ODDS_API_KEY=

# --- Local DB ---
DATABASE_URL=sqlite:///./data/sports.db

# --- Web server ---
WEB_HOST=127.0.0.1
WEB_PORT=8000
OPEN_BROWSER=true

# --- Paging (hosting H0-13): ntfy.sh private topic ---
# Pick an unguessable name (it is the only secret: anyone who knows it can
# read/post). Subscribe to it in the ntfy phone app. Blank = no push; failures
# and held PASSes still land in the receipts log.
NTFY_TOPIC=
# Second private topic: the Next-24h window card's delta pages + 08:00 ET
# digest (window service). Keep it separate from NTFY_TOPIC (operator pages).
NTFY_CARD_TOPIC=

# --- Hosting (laptop side): the host's tailnet address ---
# Used by deploy/hosting/pull_exports.py (host exports -> exports/host/).
# The Tailscale MagicDNS name or 100.x address; never hardcoded in code.
SP_HOST_ADDR=
# WRITER OF RECORD (ARCHITECT-RULE 2026-10-01): laptop until the H2 cutover,
# then host — keep it identical to the host's host.env. Receipts and
# compare_exports name it; nothing is gated on it yet.
SP_WRITER_OF_RECORD=laptop

# --- Logging ---
LOG_LEVEL=INFO

# Requests-per-minute for API-Football (and sibling api-sports products
# sharing the client). Set to your plan's allowance; default 10 (free tier).
# Paid tiers commonly allow 300 — check your dashboard. The 429 backoff
# protects you if set too high.
API_FOOTBALL_RPM=
