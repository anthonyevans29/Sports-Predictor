# /etc/sports-predictor/host.env — host-side settings for the sp_* scripts.
# Install: root:sp 0640. API keys do NOT live here: they travel in the
# checkout's .env (H0-15 manifest) and are read by config.py as on the laptop.
SP_HOST_NAME=sp-vps-1
SP_RECEIPTS=/var/log/sports-predictor/receipts.jsonl
SP_LOCK=/var/lib/sports-predictor/db.lock
SP_BACKUP_DIR=/var/backups/sports-predictor
SP_FULLSEASON_LIST=/etc/sports-predictor/fullseason.list

# H0-16 parallel-week quota mode: "full" = option (a), accepted ONLY after the
# provider-dashboard headroom receipt; "designated" = option (b), metered steps
# run only on SP_DESIGNATED_DAYS (e.g. Fri,Sat,Mon). Never option (c).
SP_PARALLEL_MODE=designated

# WRITER OF RECORD (ARCHITECT-RULE 2026-10-01): which machine's DB/exports are
# canonical — laptop until the H2 cutover flips it to host (sp_cutover.py flip).
# Consumed by every receipt line and by compare_exports (it names the canonical
# side); no behavior is gated on it yet. The laptop's .env carries the same key.
SP_WRITER_OF_RECORD=laptop

# Families whose PROVIDER sync-matches the window service skips on this host
# (statsapi.mlb.com returns 406 to the DO ASN: MLB syncing is a laptop duty).
SP_SKIP_FAMILIES=MLB
# Window-card pager state (previous card snapshot + last digest date).
SP_WINDOW_STATE=/var/lib/sports-predictor/window_state.json
SP_DESIGNATED_DAYS=

# Paging (H0-13): NTFY_TOPIC lives in the checkout's .env, not here.

# H0-14 (ruled): 14 dailies retained; prune stays REPORT-ONLY until the first
# manual prune is reviewed — only then set SP_PRUNE_APPLY=1.
SP_PRUNE_APPLY=0
SP_KEEP_DAILY=14
SP_RETAIN_DAYS=14

# Season gates (2026-09-28): a season-gated chain runs from its ruled
# default date in chains.py; set its variable here to move the start
# without a code change (YYYY-MM-DD; malformed = the chain fails loudly).
# nhl-daily: ruled default 2026-09-29 (2026-27 opening day, operator-confirmed).
SP_NHL_ACTIVE_FROM=
