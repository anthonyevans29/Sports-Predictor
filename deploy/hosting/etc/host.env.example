# /etc/sports-predictor/host.env — host-side settings for the sp_* scripts.
# Install: root:sp 0640. API keys do NOT live here: they travel in the
# checkout's .env (H0-15 manifest) and are read by config.py as on the laptop.
SP_HOST_NAME=sp-vps-1
SP_RECEIPTS=/var/log/sports-predictor/receipts.jsonl
SP_LOCK=/var/lib/sports-predictor/db.lock
SP_BACKUP_DIR=/var/backups/sports-predictor
SP_FULLSEASON_LIST=/etc/sports-predictor/fullseason.list

# H0-16 parallel-week quota mode: "full" = option (a), accepted ONLY after the
# provider-dashboard headroom receipt; "designated" = option (b), metered steps
# run only on SP_DESIGNATED_DAYS (e.g. Fri,Sat,Mon). Never option (c).
SP_PARALLEL_MODE=designated
SP_DESIGNATED_DAYS=

# H0-13 (open): failure/PASS-hold paging channel. Blank = receipts+journal only.
SP_NOTIFY_URL=

# H0-14 (open): retention. Report-only until ruled.
SP_PRUNE_APPLY=0
SP_KEEP_DAILY=7
SP_RETAIN_DAYS=14
