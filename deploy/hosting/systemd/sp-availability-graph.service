# The availability record's graph projection on the host (ARCHITECT 2026-11-04 13:05 ET, addendum 252 item 4: "a
# nightly rebuild of the record into an EMBEDDED graph engine on the host [...] rebuilt whole from SQLite (mode=ro) by
# one command, `availability-graph-rebuild`"; 2026-11-11 19:50 ET, addendum 347 item 5(b): "the rebuild NEVER runs
# inside the Desk's trust boundary: its own systemd unit with NO EnvironmentFile (it never sees host.env),
# `PrivateNetwork=yes`, `NoNewPrivileges=yes`, `ProtectSystem=strict` with one writable directory for the graph file,
# reading a `.backup` COPY of the database opened mode=ro + immutable=1, never the live file — a young native
# dependency gets no keys, no network and no write path to anything but its own output").
# Its own unit, not a chain step: a chain step runs inside sp-chain@'s unit and inherits host.env and its network.
# NO EnvironmentFile. The sp user can still READ what it owns, so the unit takes it away: /etc/sports-predictor
# (host.env, root:sp 0640, and an exports-mirror deploy key installed there) and data/ are inaccessible; the
# checkout's .env (the API keys, which config.py loads on import of any app code) is /dev/null. Another sp process's
# view is out of reach too: PrivateUsers=yes puts the unit in its own user namespace, so /proc/<pid>/environ and
# /proc/<pid>/root of sp-web or a chain (the same uid, their own mounts: .env and data/ unmasked) are refused, and
# ProtectProc=invisible / ProcSubset=pid hide them. No socket at all (RestrictAddressFamilies=none: PrivateNetwork
# leaves filesystem AF_UNIX sockets reachable). The one writable directory is the graph's: /tmp and /var/tmp are
# empty and read-only, /dev and IPC are private (PrivateDevices, PrivateIPC: no shared /dev/shm or queue), and
# SQLite's and Python's temporary files go to the graph's directory (SQLITE_TMPDIR, TMPDIR). The copy is read from
# the backup folder (read-only under ProtectSystem=strict).
# Exit 2 a refusal (the engine absent or not the pinned version, no fresh verified copy, the store not migrated);
# exit 1 a failed build; both fail the unit and OnFailure pages through sp-notify@availability-graph (its own unit,
# with its own environment). Every run is one line of logs/availability/graph/rebuild.jsonl.
# Shipped DISABLED: its enablement is the architect's block (347 item 6(D)).
[Unit]
Description=sports-predictor availability record graph projection (availability-graph-rebuild)
OnFailure=sp-notify@availability-graph.service

[Service]
Type=oneshot
User=sp
Group=sp
WorkingDirectory=/opt/sports-predictor
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SQLITE_TMPDIR=/opt/sports-predictor/logs/availability/graph
Environment=TMPDIR=/opt/sports-predictor/logs/availability/graph
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/sports-predictor/logs/availability/graph
InaccessiblePaths=/opt/sports-predictor/data /etc/sports-predictor
BindReadOnlyPaths=/dev/null:/opt/sports-predictor/.env
ProtectHome=yes
TemporaryFileSystem=/tmp:ro /var/tmp:ro
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=none
CapabilityBoundingSet=
RestrictSUIDSGID=yes
MemoryMax=1536M
Nice=10
ExecStart=/opt/sports-predictor/venv/bin/python cli.py availability-graph-rebuild --backup-dir /var/backups/sports-predictor --out /opt/sports-predictor/logs/availability/graph/availability.lbug
TimeoutStartSec=1h
