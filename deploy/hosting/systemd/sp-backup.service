# Daily .backup (sqlite3 online-backup API) + integrity_check + sha256 + receipt.
[Unit]
Description=sports-predictor daily .backup
OnFailure=sp-notify@backup.service

[Service]
Type=oneshot
User=sp
Group=sp
WorkingDirectory=/opt/sports-predictor
EnvironmentFile=-/etc/sports-predictor/host.env
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ExecStart=/opt/sports-predictor/venv/bin/python deploy/hosting/sp_backup.py daily
TimeoutStartSec=1h
