# H0-3: every boot (incl. the 04:30 UTC unattended-upgrades reboot) leaves a receipt.
[Unit]
Description=sports-predictor boot receipt
After=local-fs.target systemd-journald.service

[Service]
Type=oneshot
User=sp
Group=sp
WorkingDirectory=/opt/sports-predictor
EnvironmentFile=-/etc/sports-predictor/host.env
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ExecStart=/opt/sports-predictor/venv/bin/python deploy/hosting/sp_boot_receipt.py

[Install]
WantedBy=multi-user.target
