# The host's closing watch (ARCHITECT 2026-10-12, addendum 45 P2/P3): closing.py watch for NFL and SOCCER by name,
# never bare. SHIPPED AND HELD: not enabled by install.sh, a deploy or this file; the cutover ruling enables its
# timer (C7; hosting-h1.md T11 HELD_FOR_CUTOVER, h2-cutover-runbook.md section 1 step 5b).
# P3: "What the watch has already receipted and notified leaves with a status of its own; the unit counts that
# status and a refusal's as success, and its failure path is for what the process could not report itself."
# Exit 3 = a failed run or a miss, receipted and notified; exit 2 = a refusal, receipted and notified once per start
# time and reason. Both count as success here. OnFailure pages what the watch could not report (a start-up or
# unhandled error, exit 1, the 45-minute bound); sp_notify sends that page at most once in thirty minutes for
# this unit, by name, and receipts every failure (addendum 47 item 7(b)).
[Unit]
Description=sports-predictor closing watch (NFL, SOCCER)
Wants=network-online.target
After=network-online.target
OnFailure=sp-notify@closing-watch.service

[Service]
Type=oneshot
User=sp
Group=sp
WorkingDirectory=/opt/sports-predictor
EnvironmentFile=-/etc/sports-predictor/host.env
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
Environment=OPEN_BROWSER=false
Environment=SP_IMPROVE_HOLD_ON_PASS=1
ExecStart=/opt/sports-predictor/venv/bin/python deploy/hosting/closing.py watch --family NFL --family SOCCER
SuccessExitStatus=2 3
# P3: "Its bound is 45 minutes: a wait for the lock to T-5 and one run fit inside it."
TimeoutStartSec=45min
