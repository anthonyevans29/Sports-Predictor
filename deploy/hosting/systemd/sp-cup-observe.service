# Cups Step B's live store on the host (ARCHITECT 2026-10-27, addendum 169 item 4(i)): one observe-cup-lineups tick,
# all four cups (CL, UEL, EFL, FAC), no --loop. A tick with no poll due ends without the DB lock; one with a poll due
# holds the chains' lock (sp_common.sync_lock) across the due-check, the provider calls and the inserts.
# A refusal (exit 2: no DB file, the store not migrated, no API-Football key) is a failure here: the store would not be
# recording, so OnFailure pages it (sp_notify sends that page at most once in thirty minutes for this unit, by name).
[Unit]
Description=sports-predictor cups Step B observation tick (observe-cup-lineups)
Wants=network-online.target
After=network-online.target
OnFailure=sp-notify@cup-observe.service

[Service]
Type=oneshot
User=sp
Group=sp
WorkingDirectory=/opt/sports-predictor
EnvironmentFile=-/etc/sports-predictor/host.env
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
Environment=OPEN_BROWSER=false
ExecStart=/opt/sports-predictor/venv/bin/python cli.py observe-cup-lineups
# A tick that waits on a chain's lock outlasts the next tick's start: systemd does not start a oneshot unit that is
# still running, so the next tick is skipped, never doubled. The bound ends a tick stuck past half an hour.
TimeoutStartSec=30min
