# EXPORTS MIRROR weekly history squash (F2.5, ARCHITECT 2026-10-03). A no-op ("disabled")
# until SP_EXPORTS_MIRROR_REMOTE is set in host.env.
[Unit]
Description=sports-predictor exports mirror weekly squash
OnFailure=sp-notify@exports-squash.service

[Service]
Type=oneshot
User=sp
Group=sp
WorkingDirectory=/opt/sports-predictor
EnvironmentFile=-/etc/sports-predictor/host.env
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ExecStart=/opt/sports-predictor/venv/bin/python deploy/hosting/exports_mirror.py squash
