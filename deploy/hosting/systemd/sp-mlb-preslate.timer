# MLB pre-slate, ~1.5-2h before the earliest day game.
# H0-3: no timer fires inside the 04:15-05:15 UTC reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-mlb-preslate

[Timer]
OnCalendar=*-*-* 14:30:00 UTC
Unit=sp-chain@mlb-preslate.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
