# NCAA men's basketball market-only daily (ARCHITECT 2026-11-12, addendum 352 item 3(iii): "A NEW CHAIN,
# `ncaamb-daily`, with its own timer at a UTC minute off every existing one [...]; its timer goes on T11's
# TIMERS_BY_BLOCK (351 item 2)"): shipped, enabled only by the architect's own block after the laptop's first load
# and certification (hosting-h1.md). 07:07 UTC: off every timer's minute and off the five-minute marks of sp-window,
# sp-cup-observe and sp-availability-observe; after nba-daily (06:47) and tennis-daily (06:53), the lock waiting if
# either still runs; before intl-daily's 07:20 UTC coverage write. H0-3: no timer fires inside the 04:15-05:15 UTC
# reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-ncaamb-daily

[Timer]
OnCalendar=*-*-* 07:07:00 UTC
Unit=sp-chain@ncaamb-daily.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
