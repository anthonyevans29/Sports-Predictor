# Book + Kalshi lines for NFL (sync-odds-football also prices NCAA).
# H0-3: no timer fires inside the 04:15-05:15 UTC reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-nfl-lines

[Timer]
OnCalendar=*-*-* 15:00:00 UTC
Unit=sp-chain@nfl-lines.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
