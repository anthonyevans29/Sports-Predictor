# NHL market-only daily; the chain itself is inactive before 2026-10-07.
# H0-3: no timer fires inside the 04:15-05:15 UTC reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-nhl-daily

[Timer]
OnCalendar=*-*-* 16:00:00 UTC
Unit=sp-chain@nhl-daily.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
