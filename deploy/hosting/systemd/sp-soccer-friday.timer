# PL pre-matchweek run (pl_weekly_routine FRIDAY): the syncs only since ARCHITECT 2026-10-25, addendum 166 item 6(B)
# (the PL predict and window export left soccer-prematch; the closing watch's slate stage writes the slate file),
# then, LAST, the host-only bare export-soccer-expansion-shadow (ARCHITECT 2026-10-30, addendum 185 D2; R6): it
# writes exports/soccer_expansion_shadow_<stamp>.json and exits 2 on a refused league (D7: the failure page).
# H0-3: no timer fires inside the 04:15-05:15 UTC reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-soccer-friday

[Timer]
OnCalendar=Fri *-*-* 14:00:00 UTC
Unit=sp-chain@soccer-prematch.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
