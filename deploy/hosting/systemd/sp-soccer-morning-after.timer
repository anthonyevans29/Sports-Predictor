# PL interim grading (no refresh: H0-6).
# H0-3: no timer fires inside the 04:15-05:15 UTC reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-soccer-morning-after

[Timer]
OnCalendar=Sun,Mon,Tue *-*-* 09:50:00 UTC
Unit=sp-chain@soccer-morning-after.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
