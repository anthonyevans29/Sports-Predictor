# H0-6: soccer-refresh is OPERATOR-STARTED. There is deliberately NO timer.
#   sudo systemctl start sp-soccer-refresh.service   (then read the journal)
# sp_run takes a fresh _prerefresh_ .backup first (law 5); a failed backup
# stops the chain. A REJECTION is stop-and-investigate, not a retry.
[Unit]
Description=sports-predictor soccer-refresh (operator-started only)
Wants=network-online.target
After=network-online.target
OnFailure=sp-notify@soccer-refresh.service

[Service]
Type=oneshot
User=sp
Group=sp
WorkingDirectory=/opt/sports-predictor
EnvironmentFile=-/etc/sports-predictor/host.env
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
Environment=OPEN_BROWSER=false
ExecStart=/opt/sports-predictor/venv/bin/python deploy/hosting/sp_run.py soccer-refresh --operator --unit sp-soccer-refresh.service
TimeoutStartSec=3h
