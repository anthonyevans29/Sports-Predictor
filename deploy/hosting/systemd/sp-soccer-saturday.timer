# PL pre-kickoff refresh, ~2h before 12:30 UK; the closing-ish CLV capture. Data only since ARCHITECT 2026-10-25,
# addendum 166 item 6(B) (the PL predict and window export left soccer-prematch; the slate stage writes the file).
# H0-3: no timer fires inside the 04:15-05:15 UTC reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-soccer-saturday

[Timer]
OnCalendar=Sat *-*-* 10:30:00 Europe/London
Unit=sp-chain@soccer-prematch.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
