# Full-season sync of every competition in SP_FULLSEASON_LIST.
# H0-3: no timer fires inside the 04:15-05:15 UTC reboot buffer (tests/test_hosting_pack.py).
[Unit]
Description=sports-predictor timer: sp-weekly-fullseason

[Timer]
OnCalendar=Sun *-*-* 06:00:00 UTC
Unit=sp-chain@weekly-fullseason.service
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
